          "joint_down": "q.block_state('vfh:joint_down') == 1 && q.block_state('vfh:side_input_visual') != 'down'",
          "joint_input_north": "q.block_state('vfh:joint_south') == 1 && q.block_state('vfh:side_input_visual') == 'south'",
          "joint_input_south": "q.block_state('vfh:joint_north') == 1 && q.block_state('vfh:side_input_visual') == 'north'",
          "joint_input_east": "q.block_state('vfh:joint_east') == 1 && q.block_state('vfh:side_input_visual') == 'east'",
          "joint_input_west": "q.block_state('vfh:joint_west') == 1 && q.block_state('vfh:side_input_visual') == 'west'",
