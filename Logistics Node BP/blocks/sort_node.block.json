          },
          "default": 0
        },
        "vfh:joint_south": {
          "values": {
            "min": 0,
            "max": 1
          },
          "default": 0
        },
        "vfh:joint_east": {
          "values": {
            "min": 0,
            "max": 1
          },
          "default": 0
        },
        "vfh:joint_west": {
          "values": {
            "min": 0,
            "max": 1
          },
          "default": 0
        },
        "vfh:joint_up": {
          "values": {
            "min": 0,
            "max": 1
          },
          "default": 0
        },
        "vfh:joint_down": {
          "values": {
            "min": 0,
            "max": 1
          },
          "default": 0
        }
      }
    },
    "components": {
