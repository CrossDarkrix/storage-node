        "identifier": "geometry.vfh.ender_node",
        "bone_visibility": {
          "joint_north": "q.block_state('vfh:joint_south') == 1",
          "joint_south": "q.block_state('vfh:joint_north') == 1",
          "joint_east": "q.block_state('vfh:joint_east') == 1",
          "joint_west": "q.block_state('vfh:joint_west') == 1",
          "joint_up": "q.block_state('vfh:joint_up') == 1",
          "joint_down": "q.block_state('vfh:joint_down') == 1"
        }
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "sort_node",
          "render_method": "alpha_test"
        },
        "joint": {
          "texture": "joint",
          "render_method": "alpha_test"
        }
      },
      "minecraft:redstone_consumer": {
        "min_power": 0,
        "propagates_power": false
      },
      "vfh:sort_redstone_sync": {},
      "vfh:sort_settings": {}
    },
    "permutations": [
      {
        "condition": "query.block_state('vfh:sort_powered') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "sort_node_black",
              "render_method": "alpha_test"
            }
          }
        }
