{
  "namespace": "vfh:common",
  "white_image": {
    "type": "image",
    "texture": "textures/vfh/ui/white",
    "alpha": 0.4
  },
  "slot_template@common.container_item": {
    "ignored": false,
    "$item_collection_name": "container_items",
    "size": [
      18,
      18
    ]
  },
  "container_item_slot": {
    "type": "stack_panel",
    "collection_name": "container_items",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "$index": 0,
    "$slot_size": [
      18,
      18
    ],
    "$slot_image_size": [
      18,
      18
    ],
    "controls": [
      {
        "slot@vfh:common.slot_template": {
          "ignored": false,
          "$cell_image_size": "$slot_image_size",
          "size": "$slot_size",
          "collection_index": "$index"
        }
      }
    ]
  },
  "slot_text_display": {
    "type": "stack_panel",
    "$text_shadow|default": false,
    "$index|default": 0,
    "collection_name": "container_items",
    "controls": [
      {
        "text": {
          "collection_index": "$index",
          "type": "label",
          "layer": 8,
          "text": "#text",
          "shadow": "$text_shadow",
          "color": [
            0.33,
            0.33,
            0.33
          ],
          "bindings": [
            {
              "binding_name": "#hover_text",
              "binding_name_override": "#always_text",
              "binding_condition": "always",
              "binding_type": "collection",
              "binding_collection_name": "container_items"
            },
            {
              "binding_name": "#hover_text",
              "binding_name_override": "#display_text",
              "binding_condition": "visibility_changed",
              "binding_type": "collection",
              "binding_collection_name": "container_items"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#always_text = #display_text) or (#always_text = ''))",
              "target_property_name": "#visible"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#display_text)",
              "target_property_name": "#text"
            }
          ]
        }
      }
    ]
  },
  "auto_filler_box": {
    "type": "stack_panel",
    "layer": 34,
    "bindings": [
      {
        "binding_name": "#inventory_selected_item",
        "binding_name_override": "#item_id_aux",
        "binding_condition": "always"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#item_id_aux = -1))",
        "target_property_name": "#visible"
      }
    ],
    "collection_name": "container_items",
    "controls": [
      {
        "box_custom_item@common.container_slot_button_prototype": {
          "$highlight_control": "vfh:common.white_image",
          "$item_collection_name": "container_items",
          "collection_index": 0
        }
      }
    ]
  },
  "custom_item_count": {
    "type": "label",
    "anchor_to": "bottom_right",
    "anchor_from": "bottom_right",
    "layer": 29,
    "color": [
      1,
      1,
      1
    ],
    "offset": [
      -1.5,
      -1.5
    ],
    "shadow": true,
    "max_size": [
      "100%c",
      "100%c"
    ],
    "contained": true,
    "text": "#item_count",
    "font_scale_factor": 0.65,
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_name_override": "#always_text",
        "binding_condition": "always",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_name": "#hover_text",
        "binding_name_override": "#display_text",
        "binding_condition": "visibility_changed",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#always_text = #display_text)",
        "target_property_name": "#always_equals_display"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#always_equals_display or (#always_text = '')))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "(((((('%.10s' * #display_text) - '§o') - '§r') - '§d') - '§b') - '§e' )",
        "target_property_name": "#formatted_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "('§r' + #formatted_text - 'a')",
        "target_property_name": "#item_count"
      },
      {
        "binding_name": "#item_id_aux",
        "binding_type": "collection",
        "binding_collection_name": "container_items"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#item_id_aux = -1))",
        "target_property_name": "#visible"
      }
    ]
  },
  "slot_overlay": {
    "type": "image",
    "layer": 2,
    "size": [
      16,
      16
    ],
    "alpha": 0.5,
    "bindings": [
      {
        "binding_name": "#item_id_aux",
        "binding_type": "collection",
        "binding_collection_name": "container_items"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#item_id_aux = -1)",
        "target_property_name": "#visible"
      }
    ]
  },
  "output_template@common.container_slot_button_prototype": {
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_auto_place",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_inventory_drop",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_inventory_drop_all",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      }
    ]
  },
  "clipped_image_template": {
    "type": "collection_panel",
    "collection_name": "container_items",
    "$index|default": 0,
    "$texture|default": "textures/ui/arrow_active",
    "$clip_direction|default": "down",
    "$clip_pixelperfect|default": true,
    "$max_stack|default": 63.0,
    "$size|default": [
      22,
      15
    ],
    "size": "$size",
    "controls": [
      {
        "image": {
          "type": "image",
          "layer": 2,
          "collection_index": "$index",
          "texture": "$texture",
          "clip_direction": "$clip_direction",
          "clip_pixelperfect": "$clip_pixelperfect",
          "keep_ratio": true,
          "size": "$size",
          "uv_size": "$size",
          "bindings": [
            {
              "binding_name": "#inventory_stack_count",
              "binding_name_override": "#stack_count",
              "binding_condition": "always",
              "binding_type": "collection",
              "binding_collection_name": "container_items"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#stack_count = ''))",
              "target_property_name": "#visible"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#stack_count - '§r' - '§f' - '§o') * 1)",
              "target_property_name": "#stack_number"
            },
            {
              "binding_condition": "always",
              "binding_type": "view",
              "source_property_name": "(1 - ((#stack_number - 1) / $max_stack))",
              "target_property_name": "#clip_ratio"
            }
          ]
        }
      }
    ]
  },
  "craftable_plus_overlay": {
    "type": "image",
    "texture": "textures/vfh/ui/plus_mark",
    "size": [
      8,
      8
    ],
    "anchor_to": "top_right",
    "anchor_from": "top_right",
    "offset": [
      0,
      0
    ],
    "layer": 28,
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_name_override": "#vfh_craftable_text",
        "binding_condition": "always",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#vfh_craftable_text - '§0[VFH_CRAFTABLE]§r') = #vfh_craftable_text))",
        "target_property_name": "#visible"
      }
    ]
  }
}
