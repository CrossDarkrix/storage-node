{
  "namespace": "vfh:common_buttons",

  "button_hover": {
    "type": "panel",
    "controls": [
      {
        "highlight": {
          "type": "image",
          "texture": "$hover_button_texture",
          "controls": [],
          "bindings": [
            {
              "binding_name": "#show_tooltip",
              "binding_name_override": "#visible",
              "binding_condition": "always"
            }
          ]
        }
      }
    ]
  },

  "storage_slot_hover": {
    "type": "panel",
    "controls": [
      {
        "highlight_slot": {
          "type": "image",
          "texture": "textures/ui/highlight_slot",
          "size": ["100% - 2px", "100% - 2px"],
          "alpha": 0.8,
          "bindings": [
            {
              "binding_name": "#show_persistent_bundle_hover_text",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "white_border_slot": {
          "type": "image",
          "texture": "textures/ui/focus_border_white",
          "size": ["100%", "100%"],
          "bindings": [
            {
              "binding_name": "#show_persistent_bundle_hover_text",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "hover_text@common.hover_text": {
          "layer": 30,
          "bindings": [
            {
              "binding_name": "#hover_text",
              "binding_name_override": "#raw_hover_text",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_type": "view",
              "source_property_name": "('§r' + (#raw_hover_text - ('%.16s' * #raw_hover_text)))",
              "target_property_name": "#hover_text"
            },
            {
              "binding_name": "#show_persistent_bundle_hover_text",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "button@common.container_slot_button_prototype": {
    "layer": 1,
    "$highlight_control|default": "vfh:common_buttons.button_hover_with_text",

    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",

    "default_focus_precedence": 1,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.drop_all",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.drop_all",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "button.drop_all",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "button.drop_all",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_auto_place",
        "to_button_id": "button.drop_all",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "button.drop_all",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_inventory_drop",
        "to_button_id": "button.drop_all",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_inventory_drop_all",
        "to_button_id": "button.drop_all",
        "mapping_type": "pressed"
      }
    ],

    "controls": [
      {
        "hover@$highlight_control": {}
      },
      {
        "default": {
          "type": "image",
          "texture": "$default_button_texture"
        }
      },
      {
        "pressed": {
          "type": "image",
          "texture": "$pressed_button_texture"
        }
      }
    ]
  },

  "container_item@common.container_item": {
    "$button_size|default": [18, 18],
    "size": "$button_size",

    "$button_ref": "vfh:common_buttons.button",

    "$item_renderer_panel_size": [18, 18],
    "$item_renderer_size": [16, 16],

    "$item_collection_name": "container_items",

    "$default_button_texture": "textures/ui/cell_image",
    "$hover_button_texture": "textures/ui/cell_image",
    "$pressed_button_texture": "textures/ui/cell_image",

    "controls": [
      {
        "item_cell": {
          "type": "panel",
          "size": [18, 18],
          "controls": [
            {
              "item": {
                "type": "panel",
                "size": "$item_renderer_panel_size",
                "controls": [
                  {
                    "$item_renderer@$item_renderer": {
                      "size": "$item_renderer_size",
                      "anchor_to": "center",
                      "anchor_from": "center"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "item_button_ref@$button_ref": {
          "layer": 5,
          "$default_button_texture": "$default_button_texture",
          "$hover_button_texture": "$hover_button_texture",
          "$pressed_button_texture": "$pressed_button_texture"
        }
      }
    ]
  },

  "container_button": {
    "type": "stack_panel",
    "$index|default": 0,
    "$button_size": [18, 18],
    "size": [0, 0],
    "collection_name": "container_items",
    "controls": [
      {
        "slot@vfh:common_buttons.container_item": {
          "collection_index": "$index",
          "$button_size": "$button_size",
          "$default_button_texture": "$default_button_texture",
          "$hover_button_texture": "$hover_button_texture",
          "$pressed_button_texture": "$pressed_button_texture"
        }
      }
    ]
  },

  "button_hover_with_text": {
    "type": "panel",
    "controls": [
      {
        "highlight": {
          "type": "image",
          "texture": "$hover_button_texture",
          "bindings": [
            {
              "binding_name": "#show_tooltip",
              "binding_name_override": "#visible",
              "binding_condition": "always"
            }
          ]
        }
      },
      {
        "hover_text@common.hover_text": {
          "layer": 29,
          "bindings": [
            {
              "binding_name": "#hover_text",
              "binding_name_override": "#hover_text",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_condition": "always"
            },
            {
              "binding_name": "#show_tooltip",
              "binding_name_override": "#visible",
              "binding_condition": "always"
            }
          ]
        }
      }
    ]
  }
}
