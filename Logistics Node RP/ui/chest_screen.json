{
  "namespace": "chest",
  "chest_label": {
    "$new_container_title|default": "$container_title",
    "text": "$new_container_title"
  },
  "small_chest_screen": {
    "$new_container_title|default": "$container_title",
    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": {
          "requires": "($new_container_title = 'tile.vfh:network_controller.name')",
          "$screen_content": "vfh:storage_terminal.container_panel",
          "$screen_background_alpha": 0.4,
          "$screen_bg_content": "common.screen_background"
        }
      },
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": {
          "requires": "(($new_container_title = 'tile.vfh:crafting_terminal.name') or ($new_container_title = 'Crafting Terminal'))",
          "$screen_content": "vfh:crafting_terminal.container_panel",
          "$screen_background_alpha": 0.4,
          "$screen_bg_content": "common.screen_background"
        }
      },
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": {
          "requires": "($new_container_title = 'Large Container')",
          "$screen_content": "vfh-large-container.chest_panel",
          "$screen_background_alpha": 0.4,
          "$screen_bg_content": "common.screen_background"
        }
      },
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": {
          "requires": "($new_container_title = 'Craft Node Pattern 3x3')",
          "$screen_content": "vfh-craft-pattern.chest_panel",
          "$screen_background_alpha": 0.4,
          "$screen_bg_content": "common.screen_background"
        }
      },
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": {
          "requires": "($new_container_title = 'Output Node Filter')",
          "$screen_content": "vfh-output-filter.chest_panel",
          "$screen_background_alpha": 0.4,
          "$screen_bg_content": "common.screen_background"
        }
      }
    ]
  }
}
